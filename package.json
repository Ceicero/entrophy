{
  "name": "entrophy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @entrophy/web test:e2e && pnpm --filter @entrophy/dashboard test:e2e",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @entrophy/database generate",
    "db:migrate": "pnpm --filter @entrophy/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @entrophy/database migrate:dev",
    "db:seed": "pnpm --filter @entrophy/database seed",
    "commands:register": "pnpm --filter @entrophy/bot register",
    "commands:export": "pnpm --filter @entrophy/plugins export:commands",
    "docs:permissions": "pnpm --filter @entrophy/plugins export:permissions",
    "check:i18n": "pnpm --filter @entrophy/plugins check:i18n",
    "brand:sync": "node scripts/sync-brand.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
